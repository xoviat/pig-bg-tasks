    "url": "git+https://github.com/xoviat/pig-bg-tasks.git"
  },
  "homepage": "https://github.com/xoviat/pig-bg-tasks#readme",
  "bugs": {
    "url": "https://github.com/xoviat/pig-bg-tasks/issues"
  },
  "pi": {
    "extensions": [
      "extensions/*"
    ]
  },
  "files": [
    "extensions/pig-bg-tasks/Cargo.toml",
    "extensions/pig-bg-tasks/Cargo.lock",
    "extensions/pig-bg-tasks/src",
    "extensions/pig-bg-tasks/tests",
    "CHANGELOG.md"
  ]
