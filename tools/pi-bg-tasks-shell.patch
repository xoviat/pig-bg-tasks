@@ -43,11 +44,22 @@
     let proc;
     try {
-        proc = spawn("bash", ["-c", args.command], {
+        // Resolve the shell the way pi's core bash tool does (configured
+        // shellPath → Git Bash in standard locations → `bash` on PATH)
+        // instead of spawning a bare `bash`, which on Windows hits the WSL
+        // app-execution alias: every command then runs inside WSL with a
